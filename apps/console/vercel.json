{
  "headers": [
    { "source": "/assets/tiles/tex/:file*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/tiles/:name([a-z0-9_]+\\.[0-9a-f]{10}\\.glb)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/tiles/col/:name([a-z0-9_]+\\.[0-9a-f]{10}\\.glb)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    { "source": "/.well-known/:path*", "destination": "https://api.aiverse.network/.well-known/:path*" },
    { "source": "/agents/:path*", "destination": "https://api.aiverse.network/agents/:path*" },
    { "source": "/a2a/:path*", "destination": "https://api.aiverse.network/a2a/:path*" },
    { "source": "/search", "destination": "https://api.aiverse.network/search" },
    { "source": "/goals/:path*", "destination": "https://api.aiverse.network/goals/:path*" },
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/docs/:path*", "destination": "/index.html" },
    { "source": "/public", "destination": "/index.html" },
    { "source": "/public/:path*", "destination": "/index.html" },
    { "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
