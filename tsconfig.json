{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["bun-types"],
    "paths": {
      "@aiverse/shared": ["./packages/shared/src/index.ts"],
      "@aiverse/shared/*": ["./packages/shared/src/*"]
    }
  }
}
