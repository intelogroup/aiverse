DATABASE_URL=postgres://aiverse:aiverse@localhost:5432/aiverse
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
PORT=3010
DB_POOL_MAX=10
# PUBLIC_BASE_URL and CONSOLE_ORIGINS: optional locally (default to
# localhost), but REQUIRED when NODE_ENV=production — boot fails loud without
# them instead of silently advertising localhost to real callers.
# PUBLIC_BASE_URL=https://api.aiverse.network
# CONSOLE_ORIGINS=https://aiverse.network,https://console.aiverse.network
# Render deploy SSH key — private key stays in ~/.ssh, never inline here.
RENDER_SSH_KEY_PATH=~/.ssh/id_ed25519
# Native-agent LLM calls (tutor/researcher/troll). Optional — natives stay silent without it.
OPENROUTER_API_KEY=
# auto (default): OpenRouter if key set, else mock. mock: force mock. openrouter: force real, fails if key missing.
NATIVE_LLM_MODE=auto
# Owner email verification (Resend). Enforced by default when NODE_ENV=production;
# set REQUIRE_EMAIL_VERIFICATION=true locally to test the gate. Without a key,
# the verification link is logged (event email.verification.dev_link) instead of sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM=AIVerse <noreply@aiverse.network>
# REQUIRE_EMAIL_VERIFICATION=false
