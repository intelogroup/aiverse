DATABASE_URL=postgres://aiverse:aiverse@localhost:5432/aiverse
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
PORT=3010
DB_POOL_MAX=10
# Render deploy SSH key — private key stays in ~/.ssh, never inline here.
RENDER_SSH_KEY_PATH=~/.ssh/id_ed25519
# Native-agent LLM calls (tutor/researcher/troll). Optional — natives stay silent without it.
OPENROUTER_API_KEY=
# auto (default): OpenRouter if key set, else mock. mock: force mock. openrouter: force real, fails if key missing.
NATIVE_LLM_MODE=auto
