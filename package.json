{
  "name": "aiverse",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/gateway dev",
    "test": "bun test",
    "db:migrate": "bun run --cwd apps/gateway db:migrate",
    "db:generate": "bun run --cwd apps/gateway db:generate"
  },
  "dependencies": {
    "@aiverse/agent-sdk": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.0"
  }
}
